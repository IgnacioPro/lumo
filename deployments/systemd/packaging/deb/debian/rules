#!/usr/bin/make -f

# Debian rules file for lumo-agent
# Uses debhelper for standard package building

%:
	dh $@ --with systemd

override_dh_auto_build:
	# Binary is pre-built, skip build

override_dh_auto_install:
	# Install binary
	install -D -m 0755 lumo-agent $(CURDIR)/debian/lumo-agent/usr/local/bin/lumo-agent

	# Install systemd service
	install -D -m 0644 lumo-agent.service $(CURDIR)/debian/lumo-agent/lib/systemd/system/lumo-agent.service

	# Install default configuration
	install -D -m 0640 config.yaml $(CURDIR)/debian/lumo-agent/etc/lumo-agent/config.yaml

override_dh_installinit:
	dh_installinit --name=lumo-agent --no-start

override_dh_systemd_enable:
	dh_systemd_enable --name=lumo-agent lumo-agent.service

override_dh_systemd_start:
	dh_systemd_start --no-start --name=lumo-agent lumo-agent.service

override_dh_strip:
	# Skip stripping, binary is already stripped

override_dh_shlibdeps:
	# Skip shlib dependencies for static binary
